def main():
    """
    Main demonstration of RIS simulation
    """
    print("=" * 70)
    print("RECONFIGURABLE INTELLIGENT SURFACES (RIS) SIMULATION")
    print("=" * 70)
    
    # Initialize RIS system
    print("\nInitializing RIS-assisted communication system...")
    ris_system = RISSimulation(
        num_ris_elements=64,
        num_antennas_bs=4,
        frequency=28e9  # mmWave frequency
    )
    
    print(f"RIS Configuration:")
    print(f"  - Number of RIS elements: {ris_system.N}")
    print(f"  - BS antennas: {ris_system.M}")
    print(f"  - Carrier frequency: {ris_system.fc/1e9} GHz")
    print(f"  - Wavelength: {ris_system.wavelength:.3f} m")
    
    # Generate example channels
    print("\nGenerating wireless channels...")
    d_bs_ris = np.linalg.norm(ris_system.bs_position - ris_system.ris_positions[0])
    d_ris_user = np.linalg.norm(ris_system.ris_positions[0] - ris_system.user_position)
    d_bs_user = np.linalg.norm(ris_system.bs_position - ris_system.user_position)
    
    H_bs_ris = ris_system.generate_channel(d_bs_ris, los_condition=True)
    H_ris_user = ris_system.generate_channel(d_ris_user, los_condition=True)
    H_direct = ris_system.generate_channel(d_bs_user, los_condition=False)
    
    print(f"  - BS-RIS distance: {d_bs_ris:.2f} m")
    print(f"  - RIS-User distance: {d_ris_user:.2f} m")
    print(f"  - BS-User distance: {d_bs_user:.2f} m")
    
    # Calculate baseline SNR
    baseline_snr = ris_system.calculate_snr(H_direct, H_bs_ris, H_ris_user)
    print(f"\nBaseline SNR (without RIS optimization): {baseline_snr:.2f} dB")
    
    # Optimize phase shifts using different methods
    print("\nOptimizing RIS phase shifts...")
    
    # Method 1: Random search
    print("  - Running random search optimization...")
    phases_random = ris_system.optimize_phase_shifts_random_search(H_bs_ris, H_ris_user)
    snr_random = ris_system.calculate_snr(H_direct, H_bs_ris, H_ris_user, phases_random)
    print(f"    Achieved SNR: {snr_random:.2f} dB")
    
    # Method 2: SDR optimization
    print("  - Running SDR optimization...")
    phases_sdr = ris_system.optimize_phase_shifts_sdr(H_bs_ris, H_ris_user)
    snr_sdr = ris_system.calculate_snr(H_direct, H_bs_ris, H_ris_user, phases_sdr)
    print(f"    Achieved SNR: {snr_sdr:.2f} dB")
    
    # Calculate improvement
    improvement_random = snr_random - baseline_snr
    improvement_sdr = snr_sdr - baseline_snr
    print(f"\nPerformance Improvement:")
    print(f"  - Random optimization: {improvement_random:.2f} dB gain")
    print(f"  - SDR optimization: {improvement_sdr:.2f} dB gain")
    
    # Visualize RIS configuration
    print("\nGenerating visualization...")
    ris_system.plot_ris_configuration(phases_sdr)
    
    # Run comprehensive performance analysis
    print("\nRunning comprehensive performance analysis...")
    results = ris_system.run_performance_analysis(num_iterations=50)
    
    # Print summary statistics
    print("\n" + "=" * 70)
    print("PERFORMANCE SUMMARY")
    print("=" * 70)
    print(f"Average SNR without RIS: {np.mean(results['snr_without_ris']):.2f} dB")
    print(f"Average SNR with RIS (Random): {np.mean(results['snr_with_ris_random']):.2f} dB")
    print(f"Average SNR with RIS (SDR): {np.mean(results['snr_with_ris_sdr']):.2f} dB")
    print(f"Average Gain (SDR): {np.mean(results['gain_sdr']):.2f} dB")
    print(f"Maximum Gain (SDR): {np.max(results['g

ain_sdr']):.2f} dB")
    
    # Additional analysis: Impact of RIS size
    print("\n" + "=" * 70)
    print("ANALYZING IMPACT OF RIS SIZE")
    print("=" * 70)
    
    ris_sizes = [16, 36, 64, 100, 144]
    avg_gains = []
    
    for size in ris_sizes:
        temp_system = RISSimulation(num_ris_elements=size)
        
        # Quick performance estimate
        H_bs_ris_temp = temp_system.generate_channel(50, los_condition=True)
        H_ris_user_temp = temp_system.generate_channel(30, los_condition=True)
        H_direct_temp = temp_system.generate_channel(80, los_condition=False)
        
        baseline = temp_system.calculate_snr(H_direct_temp, H_bs_ris_temp, H_ris_user_temp)
        phases_opt = temp_system.optimize_phase_shifts_sdr(H_bs_ris_temp, H_ris_user_temp)
        optimized = temp_system.calculate_snr(H_direct_temp, H_bs_ris_temp, H_ris_user_temp, phases_opt)
        
        gain = optimized - baseline
        avg_gains.append(gain)
        
        print(f"RIS with {size:3d} elements: Gain = {gain:.2f} dB")
    
    # Plot RIS size impact
    plt.figure(figsize=(10, 6))
    plt.plot(ris_sizes, avg_gains, 'bo-', linewidth=2, markersize=8)
    plt.xlabel('Number of RIS Elements')
    plt.ylabel('Average SNR Gain (dB)')
    plt.title('Impact of RIS Size on Performance Gain')
    plt.grid(True, alpha=0.3)
    plt.xticks(ris_sizes)
    plt.show()
    
    print("\n" + "=" * 70)
    print("SIMULATION COMPLETE")
    print("=" * 70)

if name == "main":
    # Set random seed for reproducibility
    np.random.seed(42)
    
    # Run the simulation
    main()
