"""
Reconfigurable Intelligent Surfaces (RIS) Simulation for Network Communication
This code demonstrates RIS-assisted wireless communication with various optimization techniques.
"""

import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import minimize
import itertools
from typing import Tuple, List, Dict
import seaborn as sns
from matplotlib.patches import Rectangle

class RISSimulation:
    """
    A comprehensive RIS simulation framework for wireless communications
    """
    
    def init(self, 
                 num_ris_elements: int = 64,
                 num_antennas_bs: int = 4,
                 frequency: float = 28e9,  # 28 GHz for mmWave
                 ris_spacing: float = 0.5,  # wavelength spacing
                 noise_power: float = -100):  # dBm
        
        self.N = num_ris_elements  # Number of RIS elements
        self.M = num_antennas_bs   # Number of BS antennas
        self.fc = frequency        # Carrier frequency
        self.wavelength = 3e8 / frequency
        self.d_ris = ris_spacing * self.wavelength
        self.noise_power = 10**(noise_power/10)  # Convert to linear
        
        # Initialize positions
        self._initialize_positions()
        
        # Initialize channel parameters
        self.channel_state = {}
        
    def _initialize_positions(self):
        """Initialize positions of RIS, BS, and users"""
        # Create RIS array positions (uniform planar array)
        self.ris_positions = np.zeros((self.N, 3))
        n_per_side = int(np.sqrt(self.N))
        
        for i in range(n_per_side):
            for j in range(n_per_side):
                idx = i * n_per_side + j
                self.ris_positions[idx] = [
                    i * self.d_ris,
                    j * self.d_ris,
                    10  # Height of RIS
                ]
        
        # BS position
        self.bs_position = np.array([0, 50, 20])  # 50m away in y-direction
        
        # Initialize user position (will be updated dynamically)
        self.user_position = np.array([30, -30, 1.5])
        
    def generate_channel(self, 
                         distance: float,
                         los_condition: bool = True,
                         k_factor: float = 10) -> np.ndarray:
        """
        Generate channel matrix using Rician fading model
        Args:
            distance: Distance between transmitter and receiver
            los_condition: Line-of-sight condition
            k_factor: Rician K-factor
        Returns:
            Channel matrix
        """
        # Path loss model for mmWave
        path_loss = self._calculate_path_loss(distance)
        
        if los_condition:
            # Rician fading for LoS component
            los_component = np.sqrt(k_factor / (k_factor + 1))
            nlos_component = np.sqrt(1 / (k_factor + 1))
            
            # LoS component with phase based on geometry
            channel = los_component * np.exp(1j * 2 * np.pi * 
                                            np.random.rand(self.N, self.M))
            
            # NLoS component
            channel += nlos_component * (np.random.randn(self.N, self.M) + 
                                        1j * np.random.randn(self.N, self.M)) / np.sqrt(2)
        else:
            # Rayleigh fading for NLoS
            channel = (np.random.randn(self.N, self.M) + 
                      1j * np.random.randn(self.N, self.M)) / np.sqrt(2)
        
        return channel * np.sqrt(path_loss)
    
    def _calculate_path_loss(self, distance: float) -> float:
        """Calculate path loss using mmWave model"""
        # 3GPP UMi model for 28 GHz
        pl_los = 32.4 + 20 * np.log10(self.fc/1e9) + 30 * np.log10(distance)
        return 10**(-pl_los/10)
    
    def calculate_snr(self, 
                     direct_channel: np.ndarray,
                     bs_ris_channel: np.ndarray,
                     ris_user_channel: np.ndarray,
                     phase_shifts: np.ndarray = None) -> float:
        """
        Calculate SNR for RIS-assisted commun

ication
        """
        if phase_shifts is None:
            phase_shifts = np.ones(self.N)
        
        # Create diagonal phase shift matrix
        Theta = np.diag(phase_shifts)
        
        # Effective channel: H_direct + H_RIS * Theta * H_BS_RIS
        effective_channel = direct_channel + ris_user_channel @ Theta @ bs_ris_channel
        
        # Calculate received power
        tx_power = 1  # Normalized transmit power
        received_power = np.abs(effective_channel)**2 * tx_power
        
        # SNR calculation
        snr = np.sum(received_power) / self.noise_power
        
        return 10 * np.log10(snr)  # Return in dB
    
    def optimize_phase_shifts_random_search(self, 
                                           bs_ris_channel: np.ndarray,
                                           ris_user_channel: np.ndarray,
                                           iterations: int = 1000) -> np.ndarray:
        """
        Optimize phase shifts using random search
        """
        best_snr = -np.inf
        best_phases = None
        
        for _ in range(iterations):
            # Generate random phase shifts
            phases = np.exp(1j * 2 * np.pi * np.random.rand(self.N))
            
            # Calculate SNR with these phases
            snr = self.calculate_snr(
                direct_channel=np.zeros((self.N, self.M)),  # Assume blocked direct path
                bs_ris_channel=bs_ris_channel,
                ris_user_channel=ris_user_channel,
                phase_shifts=phases
            )
            
            if snr > best_snr:
                best_snr = snr
                best_phases = phases
        
        return best_phases
    
    def optimize_phase_shifts_sdr(self, 
                                 bs_ris_channel: np.ndarray,
                                 ris_user_channel: np.ndarray) -> np.ndarray:
        """
        Optimize phase shifts using Semi-Definite Relaxation (SDR)
        """
        # Construct the effective channel matrix
        H = ris_user_channel @ bs_ris_channel
        h_direct = np.zeros(self.N)  # Assume blocked direct path
        
        # SDR formulation
        M = H.shape[1]
        
        # Create the optimization variable
        V = np.outer(np.concatenate([h_direct, np.ones(1)]), 
                    np.concatenate([np.conj(h_direct), np.ones(1)]))
        
        # Solve using eigenvalue decomposition
        eigenvalues, eigenvectors = np.linalg.eig(V)
        
        # Extract the best phase shifts
        v = eigenvectors[:, np.argmax(eigenvalues)]
        phase_shifts = v[:-1] / v[-1]
        
        # Normalize to unit magnitude
        phase_shifts = phase_shifts / np.abs(phase_shifts)
        
        return phase_shifts
    
    def plot_ris_configuration(self, phase_shifts: np.ndarray = None):
        """Plot RIS configuration with phase shifts"""
        fig, axes = plt.subplots(1, 2, figsize=(15, 6))
        
        # Plot 1: RIS element phase shifts
        if phase_shifts is not None:
            n_per_side = int(np.sqrt(self.N))
            phase_matrix = np.angle(phase_shifts).reshape(n_per_side, n_per_side)
            
            im = axes[0].imshow(phase_matrix, cmap='hsv', aspect='auto')
            axes[0].set_title('RIS Phase Shifts Configuration')
            axes[0].set_xlabel('Element Index (x)')
            axes[0].set_ylabel('Element Index (y)')
            plt.colorbar(im, ax=axes[0], label='Phase (radians)')
            
            # Add grid
            axes[0].grid(True, alpha=0.3)
        
        # Plot 2: 3D network topology
        ax3d = axes[1]
        ax3d.remove()
        ax3d = fig.add_subplot(122, projection='3d')
        
        # Plot RIS elements
        ax3d.scatter(self.ris_positions[:, 0], 
                    self.ris_positions[:, 1], 
                    self.ris_positions[:, 2],
                    c='blue', s=50, label='RIS Elements', alpha=0.6)
        
        # Plot BS
        ax3d.scatter(*self.bs_position, c='red', s=200, marker='^', label='Base Station')
        


        # Plot User
        ax3d.scatter(*self.user_position, c='green', s=200, marker='o', label='User')
        
        # Draw lines for connections
        # RIS to BS
        for i in range(0, self.N, self.N//4):
            ax3d.plot([self.ris_positions[i, 0], self.bs_position[0]],
                     [self.ris_positions[i, 1], self.bs_position[1]],
                     [self.ris_positions[i, 2], self.bs_position[2]],
                     'r--', alpha=0.3)
        
        # RIS to User
        for i in range(0, self.N, self.N//4):
            ax3d.plot([self.ris_positions[i, 0], self.user_position[0]],
                     [self.ris_positions[i, 1], self.user_position[1]],
                     [self.ris_positions[i, 2], self.user_position[2]],
                     'g--', alpha=0.3)
        
        ax3d.set_xlabel('X Position (m)')
        ax3d.set_ylabel('Y Position (m)')
        ax3d.set_zlabel('Height (m)')
        ax3d.set_title('RIS-Assisted Network Topology')
        ax3d.legend()
        ax3d.grid(True)
        
        plt.tight_layout()
        plt.show()
    
    def run_performance_analysis(self, 
                                num_iterations: int = 100,
                                user_distance_range: Tuple[float, float] = (10, 100)):
        """
        Run comprehensive performance analysis
        """
        distances = np.linspace(*user_distance_range, num_iterations)
        snr_without_ris = []
        snr_with_ris_random = []
        snr_with_ris_sdr = []
        
        for distance in distances:
            # Update user position
            self.user_position = np.array([distance/2, -distance/2, 1.5])
            
            # Calculate distances
            d_bs_ris = np.linalg.norm(self.bs_position - self.ris_positions[0])
            d_ris_user = np.linalg.norm(self.ris_positions[0] - self.user_position)
            d_bs_user = np.linalg.norm(self.bs_position - self.user_position)
            
            # Generate channels
            H_bs_ris = self.generate_channel(d_bs_ris, los_condition=True)
            H_ris_user = self.generate_channel(d_ris_user, los_condition=True)
            H_direct = self.generate_channel(d_bs_user, los_condition=False)
            
            # Without RIS (only direct path)
            snr_direct = self.calculate_snr(H_direct, H_bs_ris, H_ris_user, phase_shifts=None)
            snr_without_ris.append(snr_direct)
            
            # With RIS - Random phase optimization
            phases_random = self.optimize_phase_shifts_random_search(H_bs_ris, H_ris_user)
            snr_ris_random = self.calculate_snr(H_direct, H_bs_ris, H_ris_user, phases_random)
            snr_with_ris_random.append(snr_ris_random)
            
            # With RIS - SDR optimization
            phases_sdr = self.optimize_phase_shifts_sdr(H_bs_ris, H_ris_user)
            snr_ris_sdr = self.calculate_snr(H_direct, H_bs_ris, H_ris_user, phases_sdr)
            snr_with_ris_sdr.append(snr_ris_sdr)
        
        # Plot results
        fig, axes = plt.subplots(1, 2, figsize=(15, 6))
        
        # SNR vs Distance
        axes[0].plot(distances, snr_without_ris, 'r-', linewidth=2, label='Without RIS')
        axes[0].plot(distances, snr_with_ris_random, 'b--', linewidth=2, label='With RIS (Random)')
        axes[0].plot(distances, snr_with_ris_sdr, 'g-.', linewidth=3, label='With RIS (SDR)')
        axes[0].set_xlabel('User Distance from BS (m)')
        axes[0].set_ylabel('SNR (dB)')
        axes[0].set_title('RIS Performance vs Distance')
        axes[0].legend()
        axes[0].grid(True)
        
        # Performance gain
        gain_random = np.array(snr_with_ris_random) - np.array(snr_without_ris)
        gain_sdr = np.array(snr_with_ris_sdr) - np.array(snr_without_ris)
        
        axes[1].plot(distances, gain_random, 'b--', linewidth=2, label='Random Optimization Gain')
        axes[1].plot(distances, gain_sdr, 'g-.', linewidth=3, label='SDR Optimization Gain')
        axes[1].set_xlabel('User Distance from BS (m)')
        axes[1].set_ylabel('SNR 

Gain (dB)')
        axes[1].set_title('RIS Performance Gain')
        axes[1].legend()
        axes[1].grid(True)
        
        plt.tight_layout()
        plt.show()
        
        return {
            'distances': distances,
            'snr_without_ris': snr_without_ris,
            'snr_with_ris_random': snr_with_ris_random,
            'snr_with_ris_sdr': snr_with_ris_sdr,
            'gain_random': gain_random,
            'gain_sdr': gain_sdr
        }

